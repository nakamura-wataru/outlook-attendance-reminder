{
  "name": "outlook-attendance-reminder",
  "version": "2.5.1",
  "private": true,
  "description": "Outlookまたは月〜金の週間予定から打刻を促すMacアプリ",
  "engines": { "node": ">=22" },
  "os": ["darwin"],
  "dependencies": { "node-ical": "0.27.1" },
  "overrides": {
    "rrule-temporal": "2.0.2",
    "temporal-polyfill": "1.0.2",
    "temporal-spec": "1.0.1",
    "temporal-utils": "1.0.1"
  },
  "scripts": {
    "postinstall": "bash scripts/install-app.sh --dependencies-ready",
    "install:app": "bash install.command",
    "build:native": "bash scripts/build-native.command",
    "test": "node --test source/*.test.cjs scripts/*.test.cjs",
    "test:native": "bash scripts/test-native.command"
  }
}
